@startuml
skinparam classAttributeIconSize 0

class ConsoleMenu <<Client>>

package planning {
  class PlanningService
  class FlightPlanRepository
  class FlightPlan
  class Zone
  enum FlightPlanStatus
  FlightPlan --> FlightPlanStatus
  FlightPlanRepository --> FlightPlan
  FlightPlanRepository --> Zone
}

package droneprep {
  class DronePreparationService
  class DroneRepository
  class Drone
  class DroneBooking
  enum DroneBookingStatus
  DroneBooking --> DroneBookingStatus
  DroneRepository --> Drone
  DroneRepository --> DroneBooking
}

package landing {
  class LandingService
  class DeliveryRepository
  class LandingPad
  class DeliveryConfirmation
  enum LandingPadStatus
  enum DeliveryConfirmationStatus
  LandingPad --> LandingPadStatus
  DeliveryConfirmation --> DeliveryConfirmationStatus
  DeliveryRepository --> LandingPad
  DeliveryRepository --> DeliveryConfirmation
}

package facade {
  class DispatchFacade {
    +dispatch(orderId, droneId, zone, payloadKg)
  }
  class AdminFacade {
    +showAllData()
    +compensate(chainId)
    +recoverPending()
  }
  class CompensationService
  class ChainRepository
  class DispatchChain
  enum ChainStatus
  DispatchChain --> ChainStatus
  ChainRepository --> DispatchChain
  DispatchFacade --> CompensationService
  AdminFacade --> CompensationService
  CompensationService --> ChainRepository
}

ConsoleMenu --> DispatchFacade
ConsoleMenu --> AdminFacade
DispatchFacade --> PlanningService
DispatchFacade --> DronePreparationService
DispatchFacade --> LandingService
DispatchFacade --> FlightPlanRepository
DispatchFacade --> DroneRepository
DispatchFacade --> DeliveryRepository
AdminFacade --> FlightPlanRepository
AdminFacade --> DroneRepository
AdminFacade --> DeliveryRepository
@enduml
